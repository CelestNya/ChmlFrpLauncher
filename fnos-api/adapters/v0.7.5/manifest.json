{
  "adapterName": "chmlfrp-fnos-adapter",
  "adapterVersion": "0.7.5-1.0.0",
  "apiVersion": "1.0.0",
  "upstream": {
    "repo": "TechCat-Team/ChmlFrpLauncher",
    "ref": "v0.7.5",
    "baseline": "0257a19",
    "commandSurface": 45
  },
  "purpose": "连接上游 ChmlFrpLauncher v0.7.5 与 fnOS API 1.0.0。命令面跨 0.7.5/0.8.0 一致（diff 已验证），本 adapter 主要登记插件形态与 UI 适配点。",

  "capabilities": {
    "commands": {
      "implemented": [
        "start_frpc", "stop_frpc", "is_frpc_running", "get_running_tunnels",
        "get_persisted_running_tunnels", "stop_orphan_process", "is_tunnel_process_alive",
        "set_process_guard_enabled", "get_process_guard_enabled", "add_guarded_process",
        "add_guarded_custom_tunnel", "remove_guarded_process", "check_log_and_stop_guard",
        "save_custom_tunnel", "get_custom_tunnels", "get_custom_tunnel_config",
        "update_custom_tunnel", "delete_custom_tunnel", "start_custom_tunnel",
        "stop_custom_tunnel", "is_custom_tunnel_running",
        "download_frpc", "check_frpc_exists", "get_download_url", "get_frpc_directory",
        "ping_host", "get_ports", "check_local_port", "resolve_domain_to_ip",
        "http_request", "http_request_raw",
        "save_credential", "get_credential", "clear_credential", "credential_status",
        "get_node_settings", "set_node_settings",
        "copy_background_image", "copy_background_video", "save_background_image",
        "import_background_image_folder", "get_background_video_path",
        "clear_log_history"
      ],
      "noop": [
        "fix_frpc_ini_tls", "is_autostart_enabled", "set_autostart",
        "get_tunnel_auto_start", "set_tunnel_auto_start",
        "hide_window", "show_window", "quit_app", "read_image_folder"
      ]
    },
    "events": ["frpc-log", "download-progress", "tunnel-auto-restarted"],
    "storageKeys": ["chmlfrp_user", "frpc_proxy_config", "frpcLogLevel", "bypassProxy", "restartOnEdit"],
    "plugins": ["dialog", "fs", "opener", "updater", "window", "app", "event"]
  },

  "uiFiles": {
    "description": "上游 v0.7.5 需要 fnOS 版覆盖的文件（从当前 patcher 差异提取）",
    "uiCrop": [
      "src/App.tsx",
      "src/components/pages/Settings/components/AppearanceSection.tsx",
      "src/components/pages/Settings/components/SystemSection.tsx"
    ],
    "featureBranch": [
      "src/components/pages/Settings/hooks/useBackgroundImage.ts",
      "src/components/pages/Settings/hooks/useProcessGuard.ts",
      "src/components/App/hooks/useAppInitialization.ts",
      "src/components/App/hooks/useTunnelNotifications.ts",
      "src/components/pages/TunnelList/hooks/useTunnelProgress.ts",
      "src/components/pages/Logs.tsx",
      "src/services/logStore.ts",
      "src/services/frpcManager.ts",
      "src/lib/sound.ts"
    ],
    "total": 12
  },

  "uiConfig": {
    "schemaVersion": 1,
    "description": "fnOS UI 裁剪配置（patch 消费；false = 该 UI 元素在 fnOS 上隐藏）。统一格式由 adapter 包圆，patch 的 feat 增删只影响引用哪些配置项，不改格式。",
    "values": {
      "titleBar": false,
      "antivirusWarningDialog": false,
      "autostart": false,
      "closeToTray": false,
      "backgroundFolderImport": false
    }
  },

  "versioning": {
    "rule": "adapterVersion = {上游基线版本}-{apiVersion} 联合版本号（adapter 声明自己基于哪个上游版本、适配哪个 API 版本）",
    "bump": {
      "baseline": "上游基线版本（随适配对象变，如 0.7.5 → 0.8.0）",
      "api.major": "API 接口破坏性变更时",
      "api.minor": "API 新增接口时",
      "api.patch": "本 adapter 修复（不影响 API 契约）"
    }
  }
}
