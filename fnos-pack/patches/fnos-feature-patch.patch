+function pickFolderImagesBrowser(): Promise<string[] | null> {
+  return new Promise((resolve) => {
+    const input = document.createElement("input");
+    input.type = "file";
+    input.setAttribute("webkitdirectory", "");
+    input.setAttribute("directory", "");
+    let settled = false;
+    const finish = (value: string[] | null) => {
+      if (settled) return;
+      settled = true;
+      resolve(value);
+    };
+    input.onchange = () => {
+      const files = input.files ? Array.from(input.files) : [];
+      const images = files
+        .filter((f) => f.type.startsWith("image/"))
+        .sort((a, b) => a.name.localeCompare(b.name));
+      if (images.length === 0) {
+        finish([]);
+        return;
+      }
+      const MAX_COUNT = 20;
+      const MAX_TOTAL = 4 * 1024 * 1024; // localStorage 总量保护（dataURL 已含 base64 膨胀）
+      const results: string[] = [];
+      let total = 0;
+      let idx = 0;
+      const readNext = () => {
+        if (idx >= images.length || results.length >= MAX_COUNT) {
+          finish(results);
+          return;
+        }
+        const file = images[idx++];
+        if (file.size > 2 * 1024 * 1024) {
+          readNext(); // 单张超限跳过
+          return;
+        }
+        const reader = new FileReader();
+        reader.onload = () => {
+          const dataUrl = reader.result as string;
+          total += dataUrl.length;
+          if (total > MAX_TOTAL) {
+            finish(results);
+            return;
+          }
+          results.push(dataUrl);
+          readNext();
+        };
+        reader.onerror = () => readNext();
+        reader.readAsDataURL(file);
+      };
+      readNext();
+    };
+    // 取消（Esc/关闭文件框）：cancel 事件；勿用 focus 兜底（先于 change 触发会误杀正常选择）
+    input.addEventListener("cancel", () => finish(null));
+    input.click();
+  });
+}
