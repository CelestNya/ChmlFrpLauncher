#!/bin/bash
# ChmlFrp fnOS 生命周期管理（cmd/main）。
# daemon 为常驻服务，frpc 子进程由 daemon 内部管理与守护（见 fnos-daemon/guard.rs）。
# 本脚本仅管理 daemon 自身：start / stop / status / log。
#
# 环境变量由 fnOS 注入：
#   TRIM_APPDEST   应用 target 目录（fnpack 将 app/ 内容平铺于此：chmlfrp-daemon + dist/ + ui/）
#   TRIM_PKGVAR    运行时数据目录（frpc 二进制 / 隧道配置 / PID）
#   TRIM_SERVICE_PORT  服务端口（daemon 监听）

SVC="${TRIM_APPDEST}/chmlfrp-daemon"
LOG_FILE="${TRIM_PKGVAR}/chmlfrp.log"
PID_FILE="${TRIM_PKGVAR}/chmlfrp.pid"

daemon_status() {
    [ -r "${PID_FILE}" ] || return 1
    local pid
    pid=$(cat "${PID_FILE}" 2>/dev/null)
    [ -n "${pid}" ] && kill -0 "${pid}" 2>/dev/null
}

case "$1" in
    start)
        if daemon_status; then
            echo "chmlfrp is already running" >> "${LOG_FILE}"
            exit 0
        fi
        # E5：二进制缺失/不可执行时 start 必须失败（官方退出码契约），
        # 否则应用中心显示「运行中」但实际进程未起、用户点击打开白屏
        if [ ! -x "${SVC}" ]; then
            echo "daemon 二进制不存在或不可执行: ${SVC}" >> "${LOG_FILE}"
            exit 1
        fi
        echo "Starting chmlfrp ..." >> "${LOG_FILE}"
        mkdir -p "${TRIM_PKGVAR}"
        cd "${TRIM_PKGVAR}"
        nohup "${SVC}" >> "${LOG_FILE}" 2>&1 &
        echo $! > "${PID_FILE}"
        # 启动失败检测：拉起后立即消失（二进制损坏/启动即崩）时报错退出
        sleep 1
        kill -0 "$(cat "${PID_FILE}" 2>/dev/null)" 2>/dev/null || {
            echo "daemon 启动后立即退出，请检查日志 ${LOG_FILE}" >> "${LOG_FILE}"
            exit 1
        }
        exit 0
        ;;
    stop)
        if daemon_status; then
            pid=$(cat "${PID_FILE}")
            echo "Stopping chmlfrp (${pid}) ..." >> "${LOG_FILE}"
            kill -TERM "${pid}" 2>/dev/null
            for _ in $(seq 1 20); do
                kill -0 "${pid}" 2>/dev/null || break
                sleep 1
            done
            kill -KILL "${pid}" 2>/dev/null || true
        fi
        rm -f "${PID_FILE}"
        exit 0
        ;;
    status)
        if daemon_status; then
            echo "chmlfrp is running"
            exit 0
        fi
        echo "chmlfrp is not running"
        exit 3
        ;;
    log)
        if [ -f "${LOG_FILE}" ]; then
            tail -n "${2:-100}" "${LOG_FILE}"
        else
            echo "日志文件不存在: ${LOG_FILE}"
            exit 1
        fi
        exit 0
        ;;
    *)
        exit 1
        ;;
esac
